{
  "schemaVersion": 1,
  "id": "acquiredutils",
  "version": "${version}",
  "name": "AcquiredUtils",
  "description": "Utility mod with an in-game settings GUI.",
  "authors": [
    "ii8we"
  ],
  "contact": {
    "repo": "https://github.com/ii8we/AcquiredUtils"
  },
  "license": "MIT",
  "icon": "assets/acquiredutils/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": [
      "dev.ii8we.acquiredutils.client.AcquiredUtilsClient"
    ]
  },
  "depends": {
    "fabricloader": ">=0.18.1",
    "minecraft": "~1.21.11",
    "java": ">=21",
    "fabric-api": ">=0.141.6+1.21.11"
  },
  "accessWidener": "acquiredutils.accesswidener",
  "mixins": [
    {
      "config": "acquiredutils.client.mixins.json",
      "environment": "client"
    }
  ]
}
